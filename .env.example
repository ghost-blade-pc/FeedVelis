POSTGRES_DB=velis
POSTGRES_USER=velis
POSTGRES_PASSWORD=velis
MINIO_ROOT_USER=velis
MINIO_ROOT_PASSWORD=velis-development-only

# 认证默认关闭；开启前请先按 README 的“账户与认证”初始化管理员。
# 密钥只通过环境注入，不要提交真实值，也不要写进示例：
#   VELIS_AUTH_JWT_ACTIVE_KEY / VELIS_AUTH_THROTTLE_KEY 需为 Base64，解码后至少 32 字节。
# 本地开发可参考（Cookie 只允许在 development 且来源为本机时关闭 Secure）：
# VELIS_AUTH_ENABLED=false
# VELIS_AUTH_REGISTRATION_ENABLED=false
# VELIS_AUTH_JWT_ACTIVE_KID=k1
# VELIS_AUTH_JWT_ACTIVE_KEY=
# VELIS_AUTH_ALLOWED_ORIGIN=http://localhost:5173
# VELIS_AUTH_COOKIE_SECURE=false
# VELIS_AUTH_THROTTLE_KEY=
# 部署在 velis-web 反代之后时必须填写反代自身的地址，否则 IP 维度限流会退化为全局共享。
# Compose 已把 velis-web 固定为 172.30.0.10，本地可留空取默认值；生产填反代地址。
# 只填反代自己的地址、不要填整个子网：子网包含网桥网关，客户端流量从发布端口进来时源地址就是网关。
# VELIS_AUTH_TRUSTED_PROXY_CIDRS=172.30.0.10/32
