POSTGRES_DB=velis
POSTGRES_USER=velis
POSTGRES_PASSWORD=velis
MINIO_ROOT_USER=velis
MINIO_ROOT_PASSWORD=velis-development-only

# RabbitMQ 留空时仅禁用 Relay/Consumer，Outbox 仍会持久化。
# 下值只用于本地 Compose；生产凭据必须单独注入且不得写入日志。
# VELIS_RABBITMQ_URL=amqp://velis:velis-development-only@rabbitmq:5672/velis
# VELIS_RELAY_BATCH_SIZE=100
# VELIS_RELAY_PUBLISH_WINDOW=16
# VELIS_RELAY_LEASE=30s
# VELIS_RELAY_CONFIRM_TIMEOUT=10s
# VELIS_CONSUMER_PREFETCH=16
# VELIS_OUTBOX_RETENTION=168h
# VELIS_OUTBOX_CLEANUP_INTERVAL=1h
# VELIS_OUTBOX_CLEANUP_BATCH=500
# VELIS_WORKER_METRICS_ADDRESS=0.0.0.0:9091

# Compose 内部通过 minio:9000 操作私有 Bucket，浏览器通过宿主机发布端口上传。
VELIS_ASSET_UPLOAD_ENDPOINT=http://localhost:9000
# Web Origin 是允许发起跨域上传的前端来源；它与公共上传端点含义不同。
# VELIS_ASSET_WEB_ORIGIN=http://localhost:5173
# VELIS_ASSET_BUCKET=velis-article-assets
# 成功幂等响应默认保留 24 小时；缩短会减少精确重放窗口。
# VELIS_IDEMPOTENCY_RETENTION=24h
# Feed 默认忽略 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY。只有此专用值启用可信出口代理；
# 代理负责最终 DNS/IP 安全边界，值可能含凭据，禁止提交或写日志。
# VELIS_FEED_PROXY_URL=

# 认证默认关闭；开启前请先按 README 的“账户与认证”初始化管理员。
# 密钥只通过环境注入，不要提交真实值，也不要写进示例：
#   VELIS_AUTH_JWT_ACTIVE_KEY / VELIS_AUTH_THROTTLE_KEY 需为 Base64，解码后至少 32 字节。
# 本地开发可参考（Cookie 只允许在 development 且来源为本机时关闭 Secure）：
# VELIS_AUTH_ENABLED=false
# VELIS_AUTH_REGISTRATION_ENABLED=false
# VELIS_AUTH_JWT_ACTIVE_KID=k1
# VELIS_AUTH_JWT_ACTIVE_KEY=
# VELIS_AUTH_ALLOWED_ORIGIN=http://localhost:5173
# VELIS_AUTH_COOKIE_SECURE=false
# VELIS_AUTH_THROTTLE_KEY=
# 部署在 velis-web 反代之后时必须填写反代自身的地址，否则 IP 维度限流会退化为全局共享。
# Compose 已把 velis-web 固定为 172.30.0.10，本地可留空取默认值；生产填反代地址。
# 只填反代自己的地址、不要填整个子网：子网包含网桥网关，客户端流量从发布端口进来时源地址就是网关。
# VELIS_AUTH_TRUSTED_PROXY_CIDRS=172.30.0.10/32

# AI 内容增强默认关闭。generation 与 Embedding 是相互独立的 OpenAI-compatible profile。
# 启用任一 profile 时，必须完整填写其 provider、base URL、API Key、model 和 profile version；
# API Key 仅注入 velis-worker。Embedding 还必须填写服务实际返回的向量维数。
# VELIS_AI_GENERATION_PROVIDER=openai-compatible
# VELIS_AI_GENERATION_BASE_URL=https://models.example.com/v1
# VELIS_AI_GENERATION_API_KEY=
# VELIS_AI_GENERATION_MODEL=your-chat-model
# VELIS_AI_GENERATION_PROFILE_VERSION=generation-v2
# VELIS_AI_GENERATION_TIMEOUT=30s
# VELIS_AI_GENERATION_BUDGET=2m
# VELIS_AI_GENERATION_WORKFLOW_VERSION=hierarchical-v2
# VELIS_AI_GENERATION_PROMPT_VERSION=summary-v2
# VELIS_AI_GENERATION_STRUCTURED_OUTPUT_MODE=prompt
# 输出上限参数名：默认 max_tokens；Provider 只认 max_completion_tokens 时改这里，发错参数名会让上限静默失效。
# VELIS_AI_GENERATION_MAX_TOKENS_PARAMETER=max_tokens
# VELIS_AI_GENERATION_SINGLE_INPUT_CHARS=12000
# VELIS_AI_GENERATION_CHUNK_CHARS=6000
# VELIS_AI_GENERATION_MAP_SUMMARY_MAX_CHARS=800
# VELIS_AI_GENERATION_REPAIR_INPUT_MAX_CHARS=16000
# VELIS_AI_GENERATION_MAX_CHUNKS=8
# VELIS_AI_GENERATION_CHUNK_CONCURRENCY=2
# VELIS_AI_GENERATION_MAX_CALLS=9
# VELIS_AI_GENERATION_MAX_ATTEMPTS=3
# VELIS_AI_GENERATION_BACKOFF_MIN=5s
# VELIS_AI_GENERATION_BACKOFF_MAX=5m
# VELIS_AI_GENERATION_MAX_OUTPUT_TOKENS=3072
# VELIS_AI_GENERATION_AUDIT_TOKEN_BUDGET=20000
# VELIS_AI_GENERATION_SUMMARY_MAX_CHARS=1000
# VELIS_AI_GENERATION_KEYWORD_MAX_COUNT=12
# VELIS_AI_GENERATION_TOPIC_MAX_COUNT=5
# VELIS_AI_GENERATION_LABEL_MAX_CHARS=64
# VELIS_AI_EMBEDDING_PROVIDER=openai-compatible
# VELIS_AI_EMBEDDING_BASE_URL=https://models.example.com/v1
# VELIS_AI_EMBEDDING_API_KEY=
# VELIS_AI_EMBEDDING_MODEL=your-embedding-model
# VELIS_AI_EMBEDDING_PROFILE_VERSION=embedding-v2
# VELIS_AI_EMBEDDING_TIMEOUT=20s
# VELIS_AI_EMBEDDING_BUDGET=30s
# VELIS_AI_EMBEDDING_INPUT_VERSION=retrieval-document-v1
# Cloudflare @cf/baai/bge-m3 返回 1024 维且不接受可变维数请求。
# VELIS_AI_EMBEDDING_DIMENSIONS=1024
# VELIS_AI_EMBEDDING_REQUEST_DIMENSIONS=false
# VELIS_AI_EMBEDDING_MAX_INPUT_CHARS=12000
# VELIS_AI_EMBEDDING_MAX_ATTEMPTS=3
# VELIS_AI_EMBEDDING_BACKOFF_MIN=5s
# VELIS_AI_EMBEDDING_BACKOFF_MAX=5m
# VELIS_AI_EMBEDDING_AUDIT_TOKEN_BUDGET=10000
# VELIS_AI_WORKER_LEASE=2m
# VELIS_AI_WORKER_POLL_INTERVAL=1s
# VELIS_AI_WORKER_BATCH_SIZE=8

# 搜索投影（OpenSearch）。Compose 默认把 Worker 指向内置单节点 opensearch 服务；
# 显式写成空值表示未配置 OpenSearch，投影组件保持禁用，只留下 PostgreSQL 待处理槽位。
# VELIS_SEARCH_ENDPOINTS=http://opensearch:9200
# VELIS_SEARCH_USERNAME=
# VELIS_SEARCH_PASSWORD=
# VELIS_SEARCH_INDEX_PREFIX=velis-articles
# VELIS_SEARCH_SCHEMA_VERSION=1
# VELIS_SEARCH_EMBEDDING_DIMENSIONS=1024
# VELIS_SEARCH_BULK_MAX_ITEMS=500
# VELIS_SEARCH_WORKER_LEASE=2m
# VELIS_SEARCH_WORKER_MAX_ATTEMPTS=5
# VELIS_SEARCH_REBUILD_ROLLBACK_WINDOW=24h
